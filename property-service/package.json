{
  "name": "property-service",
  "version": "1.0.0",
  "description": "Property Service API za upravljanje nepremičnin",
  "type": "module",
  "main": "property-service.js",
  "scripts": {
    "start": "node property-service.js",
    "dev": "node --watch property-service.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:api": "jest --testPathPattern=api.test --runInBand",
    "test:db": "jest --testPathPattern=db.test --runInBand",
    "test:all": "jest --testPathPattern='(api|db).test' --runInBand",
    "seed": "node scripts/seed.js"
  },
  "keywords": [
    "property",
    "api",
    "express",
    "drizzle"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "drizzle-orm": "^0.28.1",
    "mysql2": "^3.6.5",
    "dotenv": "^16.3.1",
    "amqplib": "^0.10.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  }
}
